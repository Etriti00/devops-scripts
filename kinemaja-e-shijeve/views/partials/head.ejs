<!doctype html>
<html lang="sq">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? `${title} · ${settings.blogName}` : `${settings.blogName} — ${settings.tagline}` %></title>
  <meta name="description" content="<%= description %>">
  <meta name="theme-color" content="#4e111b">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%= settings.blogName %>">
  <meta property="og:title" content="<%= title || settings.blogName %>">
  <meta property="og:description" content="<%= description %>">
  <% if (ogImage) { %><meta property="og:image" content="<%= ogImage %>"><% } %>
  <link rel="icon" href="/static/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..800,0..100,0..1;1,9..144,300..700,0..100,0..1&family=Limelight&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/site.css">
  <script>
    (function () {
      var t = null;
      try { t = localStorage.getItem('ks-theme'); } catch (e) {}
      if (!t) t = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', t);
    })();
  </script>
</head>
<body>
<a class="skip" href="#main">Kalo te përmbajtja</a>
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label="<%= settings.blogName %> — ballina">
      <span class="marquee-sign"><span class="brand-name"><%= settings.blogName %></span></span>
    </a>
    <nav class="main-nav" aria-label="Menyja kryesore">
      <a href="/" class="<%= path === '/' ? 'is-active' : '' %>">Ballina</a>
      <a href="/rreth-meje" class="<%= path === '/rreth-meje' ? 'is-active' : '' %>">Rreth meje</a>
      <form class="search" action="/kerko" role="search">
        <input type="search" name="q" placeholder="Kërko një recetë…" aria-label="Kërko një recetë" value="<%= typeof query !== 'undefined' ? query : '' %>">
      </form>
      <button type="button" class="lights" data-lights aria-label="Ndiz ose fik dritat e sallës">
        <span class="off">🌙 Fik dritat</span><span class="on">💡 Ndiz dritat</span>
      </button>
    </nav>
  </div>
  <div class="wrap">
    <nav class="genres" aria-label="Zhanret e recetave">
      <a href="/" class="<%= path === '/' ? 'is-active' : '' %>">✨ Të gjitha</a>
      <% h.CATEGORIES.forEach(function (c) { %>
        <a href="/zhanri/<%= c.slug %>" class="<%= activeCategory === c.slug ? 'is-active' : '' %>"><span aria-hidden="true"><%= c.icon %></span> <%= c.name %></a>
      <% }) %>
    </nav>
  </div>
</header>
<main id="main">
